' After login, check the username and password from the database
Sub CheckLogin

Dim Conn, cStr, sql, RS, username, userpwd

username = Request.Form("username")
userpwd = Request.Form("userpwd")


Set MyConn = Server.CreateObject("ADODB.Connection")
MyConn.Open "DRIVER={Microsoft Access Driver (*.mdb)}; DBQ=" & Server.Mappath("Database\Forms.mdb") & "; User Id=admin; Password=serbof;"
 
SQL_query = "SELECT * FROM Users WHERE Username = '" & LCase(username) & "' AND Password = '" & LCase(userpwd) & "'"
Set RS = MyConn.Execute(SQL_query)

If RS.BOF AND RS.EOF Then
    Error_Msg = "Error: Login failed. Please try again."
    ShowLogin
Else
    Session("UserLoggedIn") = "true"
    Response.Redirect "form_list.asp"
End If

RS.Close
MyConn.Close

End Sub
